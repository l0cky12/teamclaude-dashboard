# Copy to .env and adjust. All optional.
# Password for the dashboard (HTTP Basic auth, any username). Set this if the port is reachable by anyone else.
DASHBOARD_PASSWORD=
# Where the proxy listens.
TEAMCLAUDE_URL=http://127.0.0.1:3456
# Directory that holds teamclaude.json (and the state file beside it).
TEAMCLAUDE_CONFIG_DIR=~/.config
# Port the dashboard listens on.
PORT=8787
# Directory for the dashboard's own request log (activity.jsonl).
DASHBOARD_DATA_DIR=./data
